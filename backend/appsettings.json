{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Freshdesk": {
    "Domain": "uworld-support.freshdesk.com",
    "ApiKey": "YOUR_FRESHSERVICE_API_KEY",
    "ResolvedStatus": 4,
    "OpenStatus": 2
  },
  "UWorldDb": {
    "UseMockData": true,
    "ConnectionString": "Server=YOUR_SERVER;Database=UWorld;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Policy": {
    "RefundUsageDenyThresholdPercent": 50,
    "RefundWindowDays": 14,
    "RefundBorderlineLowerPercent": 20,
    "AutoSendConfidenceThreshold": 0.85,
    "AccountLockAttemptsThreshold": 5,
    "AutoHandleIntents": [
      "password_reset",
      "account_locked"
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "https://uworld-support.freshdesk.com",
      "http://localhost:10001"
    ]
  },
  "Copilot": {
    "ApiSecret": ""
  }
}
